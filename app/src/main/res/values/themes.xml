<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="Theme.Hava" parent="android:Theme.Material.Light.NoActionBar" />

  <!-- Açılış (splash) teması: installSplashScreen() sonrası Theme.Hava'ya geçer. -->
  <style name="Theme.Hava.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/Theme.Hava</item>
  </style>
</resources>
